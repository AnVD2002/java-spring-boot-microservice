<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1-add-document-storage-fields" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="documents"/>
                <not><columnExists tableName="documents" columnName="storage_provider"/></not>
            </and>
        </preConditions>
        <addColumn tableName="documents">
            <column name="storage_provider" type="VARCHAR(50)" defaultValue="MINIO">
                <constraints nullable="false"/>
            </column>
            <column name="storage_key" type="VARCHAR(1000)"/>
            <column name="original_file_name" type="VARCHAR(255)"/>
            <column name="mime_type" type="VARCHAR(255)"/>
            <column name="checksum" type="VARCHAR(128)"/>
            <column name="version" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex tableName="documents" indexName="idx_documents_storage_key">
            <column name="storage_key"/>
        </createIndex>
        <createIndex tableName="documents" indexName="idx_documents_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="documents" indexName="idx_documents_status">
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
