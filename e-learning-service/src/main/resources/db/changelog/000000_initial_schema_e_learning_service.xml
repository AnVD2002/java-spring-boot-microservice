<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================== COURSES ================== -->
    <changeSet id="1-create-courses" author="anvd35">

        <createTable tableName="courses">

            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="TEXT"/>

            <column name="thumbnail_url" type="VARCHAR(1000)"/>

            <column name="status" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="instructor_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="deleted_by" type="UUID"/>

        </createTable>

    </changeSet>

    <!-- ================== LESSONS ================== -->
    <changeSet id="2-create-lessons" author="anvd35">

        <createTable tableName="lessons">

            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="course_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_lesson_course" references="courses(id)"/>
            </column>

            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="content_url" type="VARCHAR(1000)"/>

            <column name="order_index" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="duration_minutes" type="INT" defaultValueNumeric="0"/>

            <column name="status" type="INT">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="deleted_by" type="UUID"/>

        </createTable>

    </changeSet>

</databaseChangeLog>
