<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================== SEQUENCES ================== -->
    <changeSet id="1-create-sequences" author="an">
        <createSequence sequenceName="account_id_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="account_role_id_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="account_token_id_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="blacklist_token_id_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="role_id_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <!-- ================== ACCOUNTS ================== -->
    <changeSet id="2-create-accounts" author="an">
        <createTable tableName="accounts">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="delete_by" type="BIGINT"/>
        </createTable>
    </changeSet>

    <!-- ================== ROLES ================== -->
    <changeSet id="3-create-roles" author="an">
        <createTable tableName="roles">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="delete_by" type="BIGINT"/>
        </createTable>
    </changeSet>

    <!-- ================== ACCOUNT_ROLES ================== -->
    <changeSet id="4-create-account-roles" author="an">
        <createTable tableName="account_roles">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="delete_by" type="BIGINT"/>
        </createTable>

        <!-- FK constraints -->
        <addForeignKeyConstraint baseTableName="account_roles" baseColumnNames="account_id"
                                 referencedTableName="accounts" referencedColumnNames="id"
                                 constraintName="fk_account_roles_account"/>
        <addForeignKeyConstraint baseTableName="account_roles" baseColumnNames="role_id"
                                 referencedTableName="roles" referencedColumnNames="id"
                                 constraintName="fk_account_roles_role"/>
    </changeSet>

    <!-- ================== ACCOUNT_TOKENS ================== -->
    <changeSet id="5-create-account-tokens" author="an">
        <createTable tableName="account_tokens">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="refresh_token" type="VARCHAR(512)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="issued_at" type="TIMESTAMP" />
            <column name="expires_at" type="TIMESTAMP" />
            <column name="is_revoked" type="BOOLEAN" />
            <column name="provider" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="delete_by" type="BIGINT"/>
        </createTable>

        <!-- FK to accounts -->
        <addForeignKeyConstraint baseTableName="account_tokens" baseColumnNames="user_id"
                                 referencedTableName="accounts" referencedColumnNames="id"
                                 constraintName="fk_account_tokens_user"/>
    </changeSet>

    <!-- ================== BLACKLIST_TOKENS ================== -->
    <changeSet id="6-create-blacklist-tokens" author="an">
        <createTable tableName="blacklist_tokens">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="access_token" type="VARCHAR(512)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="delete_by" type="BIGINT"/>
        </createTable>

        <!-- FK to accounts -->
        <addForeignKeyConstraint baseTableName="blacklist_tokens" baseColumnNames="user_id"
                                 referencedTableName="accounts" referencedColumnNames="id"
                                 constraintName="fk_blacklist_tokens_user"/>
    </changeSet>

</databaseChangeLog>
