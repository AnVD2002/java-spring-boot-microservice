<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================== ACCOUNTS ================== -->
    <changeSet id="1-create-accounts" author="anvd35">
        <createTable tableName="accounts">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="INT">
                <constraints nullable="false"/>
            </column>
            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="delete_by" type="UUID"/>
        </createTable>
    </changeSet>

    <!-- ================== ROLES ================== -->
    <changeSet id="2-create-roles" author="anvd35">
        <createTable tableName="roles">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="delete_by" type="UUID"/>
        </createTable>
    </changeSet>

    <!-- ================== ACCOUNT_ROLES ================== -->
    <changeSet id="3-create-account-roles" author="anvd35">
        <createTable tableName="account_roles">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="delete_by" type="UUID"/>
        </createTable>

        <!-- FK constraints -->
        <addForeignKeyConstraint baseTableName="account_roles" baseColumnNames="account_id"
                                 referencedTableName="accounts" referencedColumnNames="id"
                                 constraintName="fk_account_roles_account"/>
        <addForeignKeyConstraint baseTableName="account_roles" baseColumnNames="role_id"
                                 referencedTableName="roles" referencedColumnNames="id"
                                 constraintName="fk_account_roles_role"/>
    </changeSet>

    <!-- ================== ACCOUNT_TOKENS ================== -->
    <changeSet id="4-create-account-tokens" author="anvd35">
        <createTable tableName="account_tokens">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="refresh_token" type="VARCHAR(512)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="issued_at" type="TIMESTAMP"/>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="is_revoked" type="BOOLEAN"/>
            <column name="provider" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity fields -->
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="delete_by" type="UUID"/>
        </createTable>

        <!-- FK to accounts -->
        <addForeignKeyConstraint baseTableName="account_tokens" baseColumnNames="user_id"
                                 referencedTableName="accounts" referencedColumnNames="id"
                                 constraintName="fk_account_tokens_user"/>
    </changeSet>

    <!-- ================== DEVICE_LOG ================== -->
    <changeSet id="5-create-device-log" author="anvd35">
        <createTable tableName="device_log">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="device_id" type="UUID"/>
            <column name="user_id" type="UUID"/>
            <column name="first_seen_at" type="TIMESTAMP"/>
            <column name="last_seen_at" type="TIMESTAMP"/>
            <column name="status" type="INT"/>
            <column name="inserted_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="inserted_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="delete_by" type="UUID"/>
        </createTable>

        <!-- Optional FK -->
        <addForeignKeyConstraint baseTableName="device_log" baseColumnNames="user_id"
                                 referencedTableName="accounts" referencedColumnNames="id"
                                 constraintName="fk_device_log_user"/>
    </changeSet>
</databaseChangeLog>
